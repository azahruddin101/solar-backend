{
  "name": "sss-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=.env src/server.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/server.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "uploads:s3": "node --env-file-if-exists=.env src/scripts/uploads-to-s3.js",
    "seed:showcase": "node --env-file-if-exists=.env src/seeders/showcase.js",
    "seed:catalog": "node --env-file-if-exists=.env src/seeders/catalog.js",
    "seed": "node --env-file-if-exists=.env src/seeders/index.js",
    "seed:fresh": "node --env-file-if-exists=.env src/seeders/index.js --fresh",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  }
}
