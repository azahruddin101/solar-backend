# development | production. `npm run dev` sets development and `npm start` sets production; set it explicitly when running another way.
# NODE_ENV=production
PORT=4000
# Frontend origin(s) allowed to call this API (comma separated)
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/solar_saas
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Created on first start if no super admin exists yet (password: min 8 characters)
SUPERADMIN_EMAIL=admin@solarplanner.local
SUPERADMIN_PASSWORD=
# Server key: Solar API, Maps Static API
GOOGLE_MAPS_API_KEY=
# Public URL of the frontend (payment links)
FRONTEND_URL=http://localhost:3000
# OneSignal Web Push (dashboard → Settings → Keys & IDs). Leave empty to disable push notifications.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# File storage: set S3_BUCKET to keep uploads (logos, photos, PDFs, ticket files) in S3 instead of local disk.
# Credentials come from the standard AWS variables below (or an IAM role when hosted on AWS).
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: key prefix inside the bucket, and S3-compatible providers (MinIO, Cloudflare R2, ...)
S3_PREFIX=uploads/
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Number of reverse proxies in front of the API (so rate limits use the real client address). 0 = none.
TRUST_PROXY=0
# debug | info | warn | error. Each API hit is one line on stdout (2xx/3xx) or stderr (4xx/5xx), which PM2 records.
# Successful /health checks and CORS preflight stay at debug so they do not fill the default log.
LOG_LEVEL=info

# --- Lead integrations (Meta, Google Ads, Google Sheets) — super admin: Admin → Companies → Integrations ---
# Optional: override Meta app credentials (otherwise set in the Integrations UI, stored encrypted in MongoDB).
# META_APP_ID=
# META_APP_SECRET=
# Must match Meta app OAuth redirect: https://your-api.example.com/api/integrations/meta/callback
# META_REDIRECT_URI=
# Meta webhook verify token (same value in Meta Developer Console → Webhooks).
# META_WEBHOOK_VERIFY_TOKEN=
# Where to send the browser after Facebook Login (e.g. https://app.example.com/admin/companies/integrations).
# META_FRONTEND_REDIRECT_URL=
# 64 hex chars; encrypts stored Meta secrets. Falls back to a key derived from JWT_SECRET if unset.
# META_TOKEN_ENCRYPTION_KEY=

# Google Sheet: each company connects its own sheet in Lead integrations > Google Sheet (see docs/GOOGLE_SHEETS.md). Nothing to set here.
# Demo seeds only: the password for demo accounts, and (in production only) explicit permission to seed.
# DEMO_PASSWORD=
# ALLOW_DEMO_SEED=false
