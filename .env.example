PORT=4000
# Frontend origin(s) allowed to call this API (comma separated)
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/solar_saas
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Created on first start if no super admin exists yet (password: min 8 characters)
SUPERADMIN_EMAIL=admin@solarplanner.local
SUPERADMIN_PASSWORD=
# Server key: Solar API, Maps Static API
GOOGLE_MAPS_API_KEY=
